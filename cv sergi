<!DOCTYPE html>
<html lang="ca">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sergi Carles — Màrqueting i Comunicació</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#FFFFFF;
    --bg-soft:#F5F6FC;
    --bg-panel:#FFFFFF;
    --navy-dark:#06061C;
    --line:#E3E4F2;
    --line-strong:#C9CBEE;
    --text:#15151F;
    --text-dim:#5B5C72;
    --text-faint:#9B9CB5;
    --accent:#3533CD;
    --accent-soft:rgba(53,51,205,0.08);
    --accent-2:#7472E8;
    --grad-start:#06061C;
    --grad-end:#2B29A6;
    --radius-s:14px;
    --radius-m:20px;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--bg);
    color:var(--text);
    font-family:'Poppins',sans-serif;
    font-weight:400;
    font-size:16px;
    line-height:1.65;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  .wrap{max-width:1120px;margin:0 auto;padding:0 32px;position:relative;z-index:1;}
  h1,h2,h3{font-family:'Poppins',sans-serif;font-weight:800;letter-spacing:-0.01em;}
  .subtitle-font, .accordion-title, .sec-title, .tool-group-name, .list-block h4,
  .explore-title, .marquee-label, .footer-fact-label, .fact-label, .logo{
    font-family:'Space Grotesk',sans-serif;
  }
  a{color:inherit;text-decoration:none;}
  svg{display:block;flex-shrink:0;}
  button{font:inherit;}
  @media (prefers-reduced-motion: reduce){
    *{animation-duration:0.01ms !important; animation-iteration-count:1 !important; transition-duration:0.01ms !important;}
  }

  /* ===== NAV ===== */
  header.nav{
    position:fixed;top:0;left:0;right:0;z-index:50;
    background:rgba(255,255,255,0.86);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
  }
  .nav-inner{
    max-width:1120px;margin:0 auto;padding:0 32px;
    height:66px;display:flex;align-items:center;justify-content:space-between;
  }
  .logo{
    display:flex;align-items:center;gap:9px;
    font-weight:800;font-size:1.3rem;color:var(--text);
  }
  .logo .tally{
    width:9px;height:9px;background:var(--accent);border-radius:50%;
    box-shadow:0 0 0 4px var(--accent-soft);
    animation:pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse{0%,100%{opacity:1;}50%{opacity:0.4;}}
  .lang-switch{display:flex;gap:2px;background:var(--bg-soft);border:1px solid var(--line);border-radius:20px;padding:3px;}
  .lang-switch button{
    font-size:0.76rem;font-weight:600;
    padding:6px 14px;border:none;background:transparent;color:var(--text-dim);
    border-radius:16px;cursor:pointer;transition:background .2s,color .2s;
  }
  .lang-switch button.active{background:var(--accent);color:#fff;}
  .lang-switch button:not(.active):hover{color:var(--text);}

  /* ===== HERO ===== */
  .hero{
    position:relative;
    background:linear-gradient(120deg, var(--grad-start) 8%, var(--grad-end) 95%);
    color:#fff;
    padding-top:150px;padding-bottom:64px;
    overflow:hidden;
    width:100vw;margin-left:calc(-50vw + 50%);margin-right:calc(-50vw + 50%);
    padding-left:calc(50vw - 50% + 32px);padding-right:calc(50vw - 50% + 32px);
  }
  .hero::after{
    content:"";position:absolute;top:-30%;right:-8%;width:55%;height:160%;
    background:radial-gradient(circle, rgba(255,255,255,0.10), transparent 65%);
    pointer-events:none;
  }
  .hero-inner{position:relative;z-index:1;max-width:1056px;margin:0 auto;}
  .status-badge{
    display:inline-flex;align-items:center;gap:9px;
    font-size:0.8rem;font-weight:500;
    color:#fff;
    border:1.5px solid rgba(255,255,255,0.5);
    padding:8px 16px 8px 12px;border-radius:30px;
    margin-bottom:32px;width:fit-content;
  }
  .status-badge .dot{width:7px;height:7px;border-radius:50%;background:#fff;animation:pulse 1.6s ease-in-out infinite;}
  .hero-grid{display:grid;grid-template-columns:1fr 240px;gap:48px;align-items:center;}
  .hero-kicker{font-size:0.95rem;font-weight:600;color:#C7C6FF;margin-bottom:14px;}
  .hero-name{font-size:clamp(3.2rem,8vw,5.8rem);font-weight:900;line-height:0.94;margin-bottom:20px;color:#fff;text-transform:uppercase;}
  .hero-lead{font-size:clamp(1rem,1.6vw,1.18rem);color:rgba(255,255,255,0.82);max-width:520px;font-weight:400;}

  .hero-portrait{position:relative;justify-self:center;width:100%;max-width:220px;}
  .portrait-frame{
    position:relative;border-radius:50%;padding:7px;
    background:rgba(255,255,255,0.08);
    border:1.5px solid rgba(255,255,255,0.35);
  }
  .portrait-frame img{width:100%;display:block;border-radius:50%;aspect-ratio:1/1;object-fit:cover;}
  .float-icon{
    position:absolute;display:flex;align-items:center;justify-content:center;
    width:40px;height:40px;border-radius:50%;
    background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.3);
    color:#fff;animation:floaty 5s ease-in-out infinite;
  }
  .float-icon svg{width:18px;height:18px;}
  .fi-1{top:-6px;left:-14px;animation-delay:0s;}
  .fi-2{bottom:8px;right:-18px;animation-delay:1.2s;}
  .fi-3{top:42%;left:-30px;animation-delay:2.4s;width:30px;height:30px;}
  .fi-3 svg{width:14px;height:14px;}
  @keyframes floaty{0%,100%{transform:translateY(0);}50%{transform:translateY(-10px);}}

  .stats-row{
    display:grid;grid-template-columns:repeat(3,1fr);
    border-top:1px solid rgba(255,255,255,0.18);
    margin-top:48px;padding-top:6px;
    position:relative;z-index:1;
  }
  .stat{padding:24px 20px 6px 0;border-right:1px solid rgba(255,255,255,0.18);}
  .stat:last-child{border-right:none;}
  .stat-num{font-weight:800;font-size:2.4rem;color:#fff;line-height:1;}
  .stat-label{font-size:0.83rem;color:rgba(255,255,255,0.7);margin-top:8px;max-width:190px;}

  /* ===== MARQUEE ===== */
  .marquee-section{padding:34px 0;border-bottom:1px solid var(--line);overflow:hidden;}
  .marquee-label{font-size:0.76rem;font-weight:600;color:var(--text-faint);letter-spacing:0.04em;text-transform:uppercase;margin-bottom:16px;}
  .marquee-mask{width:100%;overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);}
  .marquee-track{display:flex;gap:12px;width:max-content;animation:scroll 34s linear infinite;}
  .marquee-track:hover{animation-play-state:paused;}
  @keyframes scroll{from{transform:translateX(0);}to{transform:translateX(-50%);}}
  .m-chip{font-size:0.86rem;font-weight:600;color:var(--accent);background:var(--accent-soft);border:1px solid var(--line-strong);padding:9px 17px;border-radius:20px;white-space:nowrap;}

  /* ===== ACCORDION SECTION ===== */
  .explore{padding:90px 0 100px;position:relative;}
  .explore::before{
    content:"";position:absolute;inset:0;z-index:-1;
    background-image:radial-gradient(circle, var(--line) 1px, transparent 1px);
    background-size:26px 26px;
    mask-image:radial-gradient(ellipse 60% 50% at 50% 0%, #000 30%, transparent 90%);
    opacity:0.6;
  }
  .explore-head{margin-bottom:44px;max-width:560px;}
  .explore-eyebrow{font-size:0.8rem;font-weight:600;color:var(--accent);margin-bottom:10px;}
  .explore-title{font-size:clamp(1.8rem,3.6vw,2.5rem);color:var(--text);margin-bottom:12px;}
  .explore-sub{font-size:1rem;color:var(--text-dim);}

  .accordion{border-top:1px solid var(--line);}
  .accordion-item{border-bottom:1px solid var(--line);}
  .accordion-head{
    width:100%;display:flex;align-items:center;gap:18px;
    padding:26px 6px;background:none;border:none;cursor:pointer;
    text-align:left;color:var(--text);transition:background .2s;
    border-radius:10px;
  }
  .accordion-head:hover{background:var(--bg-soft);}
  .accordion-icon{
    width:46px;height:46px;border-radius:13px;background:var(--accent-soft);color:var(--accent);
    display:flex;align-items:center;justify-content:center;flex-shrink:0;
    transition:background .2s,color .2s;
  }
  .accordion-icon svg{width:22px;height:22px;}
  .accordion-item.open .accordion-icon{background:var(--accent);color:#fff;}
  .accordion-titles{flex:1;min-width:0;}
  .accordion-title{font-size:1.18rem;font-weight:700;color:var(--text);}
  .accordion-count{font-size:0.85rem;color:var(--text-faint);margin-top:2px;}
  .chevron{width:22px;height:22px;color:var(--text-faint);transition:transform .3s ease;flex-shrink:0;}
  .accordion-item.open .chevron{transform:rotate(180deg);color:var(--accent);}

  .accordion-body{
    display:grid;grid-template-rows:0fr;
    transition:grid-template-rows .38s cubic-bezier(.4,0,.2,1);
  }
  .accordion-item.open .accordion-body{grid-template-rows:1fr;}
  .accordion-body-inner{overflow:hidden;min-height:0;}
  .accordion-content{padding:4px 6px 36px 70px;}

  /* --- profile content --- */
  .about-text p{font-size:1.02rem;color:var(--text-dim);max-width:620px;margin-bottom:16px;}
  .about-text p:last-child{margin-bottom:0;}
  .chips{display:flex;flex-wrap:wrap;gap:9px;margin:22px 0 26px;}
  .chip{font-size:0.8rem;font-weight:600;color:var(--accent);border:1.5px solid var(--line-strong);background:var(--accent-soft);padding:7px 14px;border-radius:20px;}
  .fact-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;max-width:520px;}
  .fact{display:flex;align-items:center;gap:12px;padding:12px 14px;background:var(--bg-soft);border-radius:12px;}
  .fact-icon{width:34px;height:34px;border-radius:9px;background:#fff;border:1px solid var(--line-strong);color:var(--accent);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
  .fact-icon svg{width:16px;height:16px;}
  .fact-value{font-size:0.88rem;font-weight:600;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .fact-value a:hover{color:var(--accent);}

  .moment-card{
    display:grid;grid-template-columns:200px 1fr;gap:20px;align-items:center;
    margin-top:26px;padding:16px;background:var(--bg-soft);border-radius:16px;border:1px solid var(--line);
    max-width:640px;
  }
  .moment-card img{width:100%;height:140px;object-fit:cover;border-radius:12px;display:block;}
  .moment-tag{font-size:0.72rem;font-weight:700;color:var(--accent);text-transform:uppercase;letter-spacing:0.04em;margin-bottom:6px;}
  .moment-text{font-size:0.88rem;color:var(--text-dim);line-height:1.5;}
  @media (max-width:560px){.moment-card{grid-template-columns:1fr;}.moment-card img{height:170px;}}

  /* --- experience --- */
  .rundown{position:relative;padding-left:26px;border-left:2px solid var(--line-strong);}
  .rundown-item{display:grid;grid-template-columns:150px 1fr;gap:32px;padding:0 0 40px;position:relative;}
  .rundown-item:last-child{padding-bottom:0;}
  .rundown-item::before{content:"";position:absolute;left:-32px;top:6px;width:11px;height:11px;border-radius:50%;background:#fff;border:3px solid var(--accent);}
  .rd-time{color:var(--accent);font-size:0.85rem;font-weight:600;padding-top:2px;}
  .rd-role{font-size:1.2rem;font-weight:700;color:var(--text);margin-bottom:3px;}
  .rd-org{font-size:0.86rem;font-weight:500;font-style:italic;color:var(--text-dim);margin-bottom:14px;}
  .rd-bullets{display:grid;gap:9px;max-width:600px;}
  .rd-bullets div{font-size:0.93rem;color:var(--text-dim);padding-left:15px;position:relative;}
  .rd-bullets div::before{content:"";position:absolute;left:0;top:9px;width:6px;height:2px;background:var(--accent);border-radius:2px;}
  .rd-bullets b{color:var(--text);font-weight:600;}

  /* --- tools --- */
  .tool-groups{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;}
  .tool-group{border:1.5px solid var(--line);border-radius:var(--radius-s);padding:20px;background:var(--bg-panel);}
  .tool-group-head{display:flex;align-items:center;gap:10px;margin-bottom:14px;padding-bottom:12px;border-bottom:1px solid var(--line);}
  .tool-group-icon{width:28px;height:28px;border-radius:8px;background:var(--accent-soft);color:var(--accent);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
  .tool-group-icon svg{width:14px;height:14px;}
  .tool-group-name{font-size:0.83rem;font-weight:600;color:var(--text-dim);}
  .tool-list{display:flex;flex-wrap:wrap;gap:7px;}
  .tool-item{font-size:0.82rem;font-weight:600;color:var(--text);background:var(--bg-soft);border:1px solid var(--line);padding:6px 11px;border-radius:8px;}

  /* --- certs / edu --- */
  .learning-block{margin-bottom:40px;}
  .learning-block:last-child{margin-bottom:0;}
  .list-block h4{display:flex;align-items:center;gap:8px;font-weight:700;font-size:0.98rem;margin-bottom:18px;color:var(--accent);}
  .list-block h4 svg{width:16px;height:16px;}

  .cert-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-bottom:14px;}
  .cert-card{border:1.5px solid var(--line);border-radius:var(--radius-s);overflow:hidden;background:#fff;transition:transform .18s ease,box-shadow .18s ease;display:block;width:100%;padding:0;text-align:left;font:inherit;color:inherit;cursor:pointer;}
  .cert-card:hover{transform:translateY(-3px);box-shadow:0 14px 30px -14px rgba(53,51,205,0.35);border-color:var(--line-strong);}
  .cert-card img{width:100%;height:168px;object-fit:cover;object-position:top;display:block;background:var(--bg-soft);}
  .cert-card-body{padding:12px 14px 14px;}
  .cert-name{font-size:0.86rem;font-weight:600;color:var(--text);display:block;}
  .cert-org{font-size:0.76rem;font-style:italic;color:var(--text-dim);}
  .cert-view{font-size:0.72rem;font-weight:600;color:var(--accent);margin-top:6px;display:flex;align-items:center;gap:4px;}
  .cert-view svg{width:12px;height:12px;}

  .cert-row{padding:11px 0;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:12px;}
  .cert-row:last-child{border-bottom:1px solid var(--line);}
  .edu-row{padding:14px 0;border-top:1px solid var(--line);}
  .edu-row:last-child{border-bottom:1px solid var(--line);}
  .edu-title{font-weight:700;font-size:0.94rem;color:var(--text);}
  .edu-meta{display:flex;justify-content:space-between;margin-top:3px;gap:10px;}
  .edu-school{font-size:0.82rem;font-style:italic;color:var(--text-dim);}
  .edu-dates{font-size:0.78rem;font-weight:600;color:var(--accent);white-space:nowrap;}
  .edu-grade{display:inline-flex;align-items:center;gap:5px;font-size:0.74rem;font-weight:700;color:#fff;background:var(--accent);padding:4px 10px;border-radius:20px;margin-top:8px;margin-right:8px;}
  .edu-grade svg{width:12px;height:12px;}
  .edu-diploma-btn{display:inline-flex;align-items:center;gap:8px;font-size:0.74rem;font-weight:600;color:var(--accent);background:var(--accent-soft);border:1px solid var(--line-strong);padding:4px 12px 4px 4px;border-radius:20px;margin-top:8px;cursor:pointer;font-family:inherit;}
  .edu-diploma-btn img{width:26px;height:26px;border-radius:50%;object-fit:cover;object-position:top;}
  .edu-diploma-btn svg{width:12px;height:12px;}

  /* --- lightbox --- */
  .lightbox{position:fixed;inset:0;z-index:100;background:rgba(6,6,28,0.86);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;padding:40px 24px;opacity:0;pointer-events:none;transition:opacity .25s ease;}
  .lightbox.open{opacity:1;pointer-events:auto;}
  .lightbox-inner{max-width:min(760px,92vw);max-height:88vh;display:flex;flex-direction:column;align-items:center;gap:14px;transform:scale(0.96);transition:transform .25s ease;}
  .lightbox.open .lightbox-inner{transform:scale(1);}
  .lightbox-inner img{max-width:100%;max-height:76vh;border-radius:12px;box-shadow:0 30px 60px -20px rgba(0,0,0,0.6);display:block;}
  .lightbox-caption{color:#fff;font-size:0.9rem;font-weight:500;text-align:center;opacity:0.85;}
  .lightbox-close{position:absolute;top:22px;right:22px;width:42px;height:42px;border-radius:50%;background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.3);color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;}
  .lightbox-close svg{width:18px;height:18px;}
  .lightbox-close:hover{background:rgba(255,255,255,0.22);}

  /* --- languages --- */
  .lang-meters{display:grid;gap:20px;max-width:600px;}
  .meter-row{display:grid;grid-template-columns:110px 1fr 90px;align-items:center;gap:16px;}
  .meter-name{font-weight:600;font-size:0.94rem;}
  .meter-track{height:9px;background:var(--bg-soft);border-radius:6px;border:1px solid var(--line);overflow:hidden;}
  .meter-fill{height:100%;border-radius:6px;background:linear-gradient(90deg,var(--accent-2),var(--accent));width:0%;transition:width 1.1s cubic-bezier(.16,.8,.3,1);}
  .meter-level{font-size:0.8rem;font-weight:600;color:var(--accent);text-align:right;}

  /* ===== FOOTER ===== */
  footer{
    padding:90px 0 44px;
    background:linear-gradient(120deg, var(--grad-start) 8%, var(--grad-end) 95%);
    color:#fff;
  }
  .footer-title{font-size:clamp(2rem,5vw,3.4rem);font-weight:800;line-height:1.08;max-width:760px;margin-bottom:38px;color:#fff;}
  .footer-links{display:flex;flex-wrap:wrap;gap:14px;margin-bottom:56px;}
  .btn{font-weight:600;font-size:0.9rem;padding:14px 28px;border-radius:30px;cursor:pointer;border:1.5px solid transparent;transition:transform .15s ease,background .2s,border-color .2s;display:inline-flex;align-items:center;gap:8px;}
  .btn:hover{transform:translateY(-2px);}
  .btn-primary{background:#fff;color:var(--accent);}
  .btn-primary:hover{background:#EDEDFF;}
  .btn-ghost{border-color:rgba(255,255,255,0.55);color:#fff;}
  .btn-ghost:hover{border-color:#fff;background:rgba(255,255,255,0.08);}
  .footer-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;border-top:1px solid rgba(255,255,255,0.2);padding-top:28px;}
  .f-fact{display:flex;align-items:center;gap:12px;}
  .f-fact-icon{width:36px;height:36px;border-radius:10px;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.25);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
  .f-fact-icon svg{width:16px;height:16px;}
  .footer-fact-label{font-size:0.7rem;font-weight:600;letter-spacing:0.03em;color:#B8B7F5;text-transform:uppercase;}
  .footer-fact-value{font-size:0.92rem;color:#fff;font-weight:500;}
  .footer-fact-value a:hover{color:#C7C6FF;}
  .footer-bottom{margin-top:52px;font-size:0.78rem;color:#9C9BE0;display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;}

  @media (max-width:860px){
    .wrap{padding:0 20px;}
    .hero{padding-top:118px;}
    .hero-grid{grid-template-columns:1fr;}
    .hero-portrait{max-width:160px;justify-self:start;order:-1;margin-bottom:20px;}
    .float-icon{display:none;}
    .stats-row{grid-template-columns:1fr;}
    .stat{border-right:none;border-bottom:1px solid rgba(255,255,255,0.18);padding:16px 0;}
    .accordion-content{padding-left:20px;}
    .fact-grid{grid-template-columns:1fr;}
    .rundown{padding-left:18px;}
    .rundown-item{grid-template-columns:1fr;gap:6px;}
    .rundown-item::before{left:-24px;}
    .tool-groups{grid-template-columns:1fr;}
    .cert-edu-grid{grid-template-columns:1fr;gap:36px;}
    .meter-row{grid-template-columns:78px 1fr 56px;gap:10px;}
    .footer-grid{grid-template-columns:1fr;gap:20px;}
    .explore{padding:60px 0 70px;}
  }
</style>
</head>
<body>

<header class="nav">
  <div class="nav-inner">
    <div class="logo"><span class="tally"></span>SC</div>
    <div class="lang-switch" id="langSwitch">
      <button data-lang="ca">CA</button>
      <button data-lang="es">ES</button>
      <button data-lang="en">EN</button>
    </div>
  </div>
</header>

<main>

  <!-- HERO -->
  <section class="hero">
   <div class="hero-inner">
    <div class="status-badge"><span class="dot"></span><span data-t="statusBadge"></span></div>
    <div class="hero-grid">
      <div>
        <div class="hero-kicker" data-t="heroKicker"></div>
