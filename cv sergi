function renderAccordion(lang){
  const d = DATA[lang];
  const acc = document.getElementById('accordion');
  const openKeys = new Set(Array.from(acc.querySelectorAll('.accordion-item.open')).map(el=>el.getAttribute('data-key')));
  acc.innerHTML = d.accItems.map(item=>`
    <div class="accordion-item${openKeys.has(item.key)?' open':''}" data-key="${item.key}">
      <button class="accordion-head" type="button">
        <span class="accordion-icon">${svg(item.icon)}</span>
        <span class="accordion-titles">
          <span class="accordion-title">${item.title}</span>
          <span class="accordion-count">${item.count}</span>
        </span>
        <span class="chevron">${svg('chevron')}</span>
      </button>
      <div class="accordion-body"><div class="accordion-body-inner"><div class="accordion-content">${accordionSectionHTML(item.key, d)}</div></div></div>
    </div>
  `).join('');

  acc.querySelectorAll('.accordion-head').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const item = btn.closest('.accordion-item');
      const wasOpen = item.classList.contains('open');
      item.classList.toggle('open');
      if(!wasOpen){
        item.querySelectorAll('.meter-fill').forEach(f=>{
          requestAnimationFrame(()=>{ f.style.width = f.getAttribute('data-pct') + '%'; });
        });
      }
    });
  });
}

function renderMarquee(lang){
  const d = DATA[lang];
  const all = d.toolGroups.flatMap(g=>g.items);
  const doubled = all.concat(all);
  document.getElementById('marqueeTrack').innerHTML = doubled.map(t=>`<span class="m-chip">${t}</span>`).join('');
}

function renderAll(lang){
  currentLang = lang;
  renderStatic(lang);
  renderAccordion(lang);
  renderMarquee(lang);
  document.querySelectorAll('#langSwitch button').forEach(b=>{
    b.classList.toggle('active', b.getAttribute('data-lang') === lang);
  });
}

document.getElementById('langSwitch').addEventListener('click', e=>{
  const btn = e.target.closest('button');
  if(!btn) return;
  renderAll(btn.getAttribute('data-lang'));
});

